{
  "id": "plaats-detail",
  "screenType": "normal",
  "globals": {
  },
  "form": {
    "rows": [
      {
        "displayType": "group",
        "groupId": "plaats",
        "rows": [
          {
            "elements": [
              {
                "value": "$data#/plaatsnaam",
                "type": "label"
              }
            ]
          },
          {
            "elements": [
              {
                "value": {
                  "latitude": "$data#/coordinaten/breedteGraad",
                  "longitude": "$data#/coordinaten/lengteGraad"
                },
                "type": "map",
                "config": {
                  "zoom": 6
                }
              }
            ]
          },
          {
            "columns": [
              {
                "elements": [
                  {
                    "value": "$data#/coordinaten/breedteGraad",
                    "type": "label"
                  }
                ]
              },
              {
                "elements": [
                  {
                    "value": "$data#/coordinaten/lengteGraad",
                    "type": "label"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}